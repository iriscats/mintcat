{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.mint.cat",
  "bundle": {
    "targets": ["nsis"],
    "resources": {
      "assets/oo2core_9_win64.dll": "oo2core_9_win64.dll",
      "Microsoft.WebView2.FixedVersionRuntime.x64/": "Microsoft.WebView2.FixedVersionRuntime.x64/"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "fixedRuntime",
        "path": "./Microsoft.WebView2.FixedVersionRuntime.x64/"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "languages": ["SimpChinese", "English"],
        "installMode": "perMachine"
      }
    }
  }
}
